# Copy to .env. Local mode runs on loopback and never sends external email.
PORT=4173
# Docker overrides HOST to 0.0.0.0 on its private network.
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:4173
# Set the club's timezone in the application settings.
# Production: set NODE_ENV=production, HTTPS APP_ORIGIN, ADMIN_EMAIL,
# SESSION_SECRET (at least 32 random characters), RESEND_API_KEY and MAIL_FROM.
# Provision the first administrator by signing in with this verified email.
ADMIN_EMAIL=
SESSION_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Enable only after reviewing the monthly statement flow with real data.
AUTO_STATEMENTS=false
# Public Firebase web config from Project settings > Your apps (single-line JSON).
# Enable Google in Authentication and authorize localhost before using it.
# No service-account private key is needed for ID token verification.
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","appId":"..."}
